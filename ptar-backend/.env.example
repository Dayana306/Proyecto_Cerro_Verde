# Copiar como .env (junto a docker-compose.yml) y ajustar. NUNCA subir .env al repositorio.

# --- Perfil: dev (Swagger + datos demo) | prod ---
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_DATABASE=ptar_enlozada
MYSQL_USER=smcv_app
MYSQL_PASSWORD=smcv_dev

# --- Seguridad (JWT) ---
# Mínimo 32 caracteres. Para generar uno:  openssl rand -base64 48
JWT_SECRET=secreto_de_desarrollo_cambiar_en_produccion_0123456789
JWT_EXPIRATION_MINUTES=480

# --- Frontend que consumirá la API (separados por coma) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Datos de demostración (solo perfil dev) ---
DEMO_DATA=false

# --- Recuperación de contraseña por correo (opcional para arrancar el backend) ---
# Completar con las credenciales SMTP del proveedor. No subir valores reales al repositorio.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
FRONTEND_URL=http://localhost:5173
