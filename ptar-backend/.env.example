#copiar a .env y ajustar. no subir .env al repositorio.

# --- Perfil de Spring ---
# dev  = desarrollo local (crea un administrador inicial). NO usar en producción.
SPRING_PROFILES_ACTIVE=dev

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=cambiar_root
MYSQL_DATABASE=ptar_enlozada
MYSQL_USER=smcv_app
MYSQL_PASSWORD=smcv_dev

# --- JWT ---
# minimo 32 caracteres, generar uno: openssl rand -base64 48
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio_de_32_o_mas_caracteres
JWT_EXPIRATION_MINUTES=480

# --- CORS (URL del frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
